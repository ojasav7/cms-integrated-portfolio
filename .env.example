# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# MongoDB — Prisma 6 provider "mongodb". Leave commented out to run the site
# on the static JSON fallbacks with zero DB config.
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/myportfolio"

# Auth — single admin password + cookie signing secret
ADMIN_PASSWORD="your-secret-admin-password"
SESSION_SECRET="a-random-32-char-string"

# Cloudinary — media uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
